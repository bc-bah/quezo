# Local Docker configuration; neither application shell automatically reads this file.
# Copy to .env and supply your own local-only credentials before starting containers.
POSTGRES_DB=quezo
POSTGRES_USER=quezo
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Required, distinct, nonempty role passwords when initializing a NEW postgres volume.
QUEZO_MIGRATION_PASSWORD=
QUEZO_RUNTIME_PASSWORD=
QUEZO_WEB_PASSWORD=
# Export URLs explicitly to the process that needs them; URL-encode passwords.
# Runtime never receives the bootstrap or migration credential.
QUEZO_DATABASE_URL=
QUEZO_MIGRATION_URL=
# Disposable test service only; never reuse development or shared credentials.
QUEZO_TEST_PORT=55432
QUEZO_TEST_ADMIN_PASSWORD=
QUEZO_TEST_MIGRATION_PASSWORD=
QUEZO_TEST_RUNTIME_PASSWORD=
QUEZO_TEST_WEB_PASSWORD=
# postgresql://quezo_test_admin:<encoded-password>@127.0.0.1:55432/quezo_test_control
QUEZO_TEST_ADMIN_URL=
KEYCLOAK_ADMIN=quezo-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8080
# Export to the WEB server only; never NEXT_PUBLIC_. No admin/migration credentials.
QUEZO_WEB_ENV=local
QUEZO_WEB_ORIGIN=http://localhost:3000
QUEZO_BACKEND_ORIGIN=http://localhost:4000
QUEZO_OIDC_ISSUER=http://localhost:8080/realms/quezo-local
QUEZO_OIDC_CLIENT_ID=quezo-web
QUEZO_OIDC_CLIENT_SECRET=
# Client scope of this name must add this dedicated access-token audience.
QUEZO_API_AUDIENCE=quezo-api
# postgresql://quezo_web:<encoded-password>@127.0.0.1:5432/quezo
QUEZO_WEB_DATABASE_URL=
